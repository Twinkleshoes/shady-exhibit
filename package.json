{
  "name": "the-shady-exhibit",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build",
    "start": "node --import tsx server.ts --production",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 src/game/physics.test.ts src/game/rules.test.ts src/game/cameras.test.ts src/game/engine.test.ts src/game/camera-speed.test.ts src/game/layout.test.ts src/game/characters.test.ts src/game/identity.test.ts src/game/cover.test.ts src/game/lamp-carry.test.ts src/game/tour.test.ts src/game/preparation.test.ts src/game/audio.test.ts src/game/results.test.ts src/game/duel.test.ts",
    "test:preparation-browser": "node scripts/preparation-browser.mjs",
    "test:preparation-network": "node scripts/preparation-network.mjs",
    "test:preparation": "node --import tsx --test src/game/preparation.test.ts",
    "test:menu-edge": "node scripts/menu-edge-browser.mjs",
    "test:menu-browser": "node scripts/menu-browser.mjs",
    "test:tour-network": "node scripts/tour-network-check.mjs",
    "test:tour": "node --import tsx --test src/game/tour.test.ts src/game/preparation.test.ts",
    "test:integration": "node --import tsx --test src/game/integration.test.ts",
    "test:browser": "node --import tsx scripts/browser-check.mjs",
    "test:camera-browser": "node --import tsx scripts/camera-speed-browser.mjs",
    "test:layout-browser": "node --import tsx scripts/layout-browser.mjs",
    "map": "node --import tsx scripts/floor-plan.mjs",
    "test:gem-browser": "node --import tsx scripts/gem-refinement-browser.mjs",
    "test:rooms-browser": "node --import tsx scripts/finished-rooms-browser.mjs",
    "test:characters-browser": "node --import tsx scripts/characters-browser.mjs",
    "test:architecture-browser": "node --import tsx scripts/architecture-browser.mjs",
    "bake:visitors": "node --import tsx scripts/bake-visitors.mjs",
    "test:smooth-preview": "node scripts/smooth-visitor-preview.mjs",
    "test:materials-browser": "node --import tsx scripts/materials-browser.mjs",
    "test:identity-browser": "node --import tsx scripts/identity-browser.mjs",
    "test:lamp-browser": "node --import tsx scripts/lamp-browser.mjs",
    "test:cover-browser": "node --import tsx scripts/cover-browser.mjs",
    "test:audio-browser": "node scripts/audio-browser.mjs",
    "test:audio": "node --import tsx --test src/game/audio.test.ts",
    "test:results": "node --import tsx --test src/game/results.test.ts",
    "test:results-browser": "node --import tsx scripts/results-fixtures.mjs && node --import tsx scripts/results-browser.mjs",
    "test:results-network": "node scripts/results-network.mjs",
    "test:duel": "node --import tsx --test src/game/duel.test.ts",
    "test:duel-browser": "node --import tsx scripts/duel-browser.mjs",
    "test:duel-network": "node --import tsx --test --test-name-pattern=\"DUEL real\" src/game/integration.test.ts",
    "test:hosting": "node scripts/hosting-smoke.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "vite": "^8.3.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
